{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{providers/**,providers.json,manifest.json,assets/**}"
    }
  },
  "routes": [
    {
      "src": "/manifest\\.json",
      "dest": "/api/index"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
